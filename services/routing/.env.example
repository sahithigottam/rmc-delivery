# Routing Microservice Configuration
ENV=development

# Database (use SQLite locally, PostgreSQL in production)
DATABASE_URL=sqlite:///./rmc_routing.db

# Google Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# FastAPI
LOG_LEVEL=INFO

# API Configuration
API_V1_PREFIX=/api/v1
API_TITLE=RMC Routing Microservice
API_VERSION=1.0.0
